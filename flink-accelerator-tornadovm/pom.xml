<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>io.github.beehive-lab</groupId>
		<artifactId>flink-accelerator-tornadovm-parent</artifactId>
		<version>0.1.0-SNAPSHOT</version>
	</parent>

	<artifactId>flink-accelerator-tornadovm</artifactId>
	<name>Flink Accelerator : TornadoVM</name>

	<description>
		The provider itself: kernel generation from Flink's accelerator IR, gather strategies, the
		staging operator, and the AcceleratorProvider that a TaskManager discovers by ServiceLoader.

		Deploy by putting this jar in a distribution's lib/. Flink holds no reference to it, so a
		TaskManager without it -- or without a device, or without a JVM configured for TornadoVM --
		runs the code-generated operator instead and logs why.
	</description>

	<dependencies>
		<dependency>
			<groupId>org.apache.flink</groupId>
			<artifactId>flink-table-common</artifactId>
			<version>${flink.version}</version>
			<scope>provided</scope>
		</dependency>
		<!--
			Carries the AcceleratorProvider SPI and AcceleratedCalcSpec. Deliberately not
			flink-table-planner: the contract between Flink and an accelerator has no business
			referring to Calcite, and a provider that needed the planner would be back inside the
			coupling this split exists to remove.
		-->
		<dependency>
			<groupId>org.apache.flink</groupId>
			<artifactId>flink-table-runtime</artifactId>
			<version>${flink.version}</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>io.github.beehive-lab</groupId>
			<artifactId>tornado-api</artifactId>
			<version>${tornado.version}</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>io.github.beehive-lab</groupId>
			<artifactId>tornado-annotation</artifactId>
			<version>${tornado.version}</version>
			<scope>provided</scope>
		</dependency>
		<!--
			The cuBLAS binding, for the hybrid path: a generated kernel and a library call sharing
			device buffers in one TaskGraph. Nothing in the Calc operator uses it, so a
			distribution without it still runs every Calc.

			It needs no JNI native of its own. TornadoVM 6 binds through java.lang.foreign and
			dlopens the system libcublas, so the only run-time requirement is a CUDA install.
		-->
		<dependency>
			<groupId>io.github.beehive-lab</groupId>
			<artifactId>tornado-cublas</artifactId>
			<version>${tornado.version}</version>
			<scope>provided</scope>
		</dependency>
		<!-- The operator test harness, for the device-gated tests under -Pdevice. -->
		<dependency>
			<groupId>org.apache.flink</groupId>
			<artifactId>flink-streaming-java</artifactId>
			<version>${flink.version}</version>
			<type>test-jar</type>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.flink</groupId>
			<artifactId>flink-runtime</artifactId>
			<version>${flink.version}</version>
			<type>test-jar</type>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.flink</groupId>
			<artifactId>flink-core</artifactId>
			<version>${flink.version}</version>
			<type>test-jar</type>
			<scope>test</scope>
		</dependency>
		<!--
			Provided, not test. The operator extends AbstractStreamOperator, so main code needs
			it; declaring it test-scope for the harness silently demoted the transitive
			compile-scope copy from flink-table-runtime and broke the main compile — which only
			showed up on the first `clean` build, because stale classes covered for it until then.
		-->
		<dependency>
			<groupId>org.apache.flink</groupId>
			<artifactId>flink-streaming-java</artifactId>
			<version>${flink.version}</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.flink</groupId>
			<artifactId>flink-test-utils-junit</artifactId>
			<version>${flink.version}</version>
			<scope>test</scope>
			<exclusions>
				<!-- It carries the JUnit 4 bridge for Flink's own legacy tests. Nothing here is
				     JUnit 4, and pulling the vintage engine in makes an otherwise offline build
				     reach for the network. -->
				<exclusion>
					<groupId>org.junit.vintage</groupId>
					<artifactId>junit-vintage-engine</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
	</dependencies>
</project>
