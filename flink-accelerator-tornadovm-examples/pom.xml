<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>io.github.beehive-lab</groupId>
		<artifactId>flink-accelerator-tornadovm-parent</artifactId>
		<version>0.1.0-SNAPSHOT</version>
	</parent>

	<artifactId>flink-accelerator-tornadovm-examples</artifactId>
	<name>Flink Accelerator : TornadoVM : Examples</name>

	<description>
		Runnable examples and benchmarks for the provider.

		They live here rather than in flink-examples because every one of them needs a device.
		Three are ordinary Flink SQL and need the provider only on the classpath -- which is the
		point they exist to make -- but they assert that offload actually happened, so without it
		they fail rather than passing trivially. The other three drive the engines directly,
		because no planner path reaches an aggregate or a join yet.
	</description>

	<dependencies>
		<dependency>
			<groupId>io.github.beehive-lab</groupId>
			<artifactId>flink-accelerator-tornadovm</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>org.apache.flink</groupId>
			<artifactId>flink-table-api-java-bridge</artifactId>
			<version>${flink.version}</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.flink</groupId>
			<artifactId>flink-table-planner-loader</artifactId>
			<version>${flink.version}</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.flink</groupId>
			<artifactId>flink-table-runtime</artifactId>
			<version>${flink.version}</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.flink</groupId>
			<artifactId>flink-clients</artifactId>
			<version>${flink.version}</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.apache.flink</groupId>
			<artifactId>flink-connector-datagen</artifactId>
			<version>${flink.version}</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>io.github.beehive-lab</groupId>
			<artifactId>tornado-api</artifactId>
			<version>${tornado.version}</version>
			<scope>provided</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!--
				One runnable jar per example, named after it, exactly as flink-examples-table did
				before these moved here. The run scripts under the provider module look the jars up
				by that bare name, and a benchmark is submitted with `flink run`, so the manifest
				has to name the class.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<version>3.4.1</version>
				<executions>
					<execution>
						<id>GpuOffloadExample</id>
						<phase>package</phase>
						<goals>
							<goal>jar</goal>
						</goals>
						<configuration>
							<classifier>GpuOffloadExample</classifier>
							<archive>
								<manifestEntries>
									<program-class>org.apache.flink.table.examples.java.gpu.GpuOffloadExample</program-class>
								</manifestEntries>
							</archive>
							<includes>
								<include>org/apache/flink/table/examples/java/gpu/GpuOffloadExample*</include>
							</includes>
						</configuration>
					</execution>
					<execution>
						<id>HaversineBenchmark</id>
						<phase>package</phase>
						<goals>
							<goal>jar</goal>
						</goals>
						<configuration>
							<classifier>HaversineBenchmark</classifier>
							<archive>
								<manifestEntries>
									<program-class>org.apache.flink.table.examples.java.gpu.HaversineBenchmark</program-class>
								</manifestEntries>
							</archive>
							<includes>
								<include>org/apache/flink/table/examples/java/gpu/HaversineBenchmark*</include>
							</includes>
						</configuration>
					</execution>
					<execution>
						<id>GroupedAggregateBenchmark</id>
						<phase>package</phase>
						<goals>
							<goal>jar</goal>
						</goals>
						<configuration>
							<classifier>GroupedAggregateBenchmark</classifier>
							<archive>
								<manifestEntries>
									<program-class>org.apache.flink.table.examples.java.gpu.GroupedAggregateBenchmark</program-class>
								</manifestEntries>
							</archive>
							<includes>
								<include>org/apache/flink/table/examples/java/gpu/GroupedAggregateBenchmark*</include>
							</includes>
						</configuration>
					</execution>
					<execution>
						<id>SortBenchmark</id>
						<phase>package</phase>
						<goals>
							<goal>jar</goal>
						</goals>
						<configuration>
							<classifier>SortBenchmark</classifier>
							<archive>
								<manifestEntries>
									<program-class>org.apache.flink.table.examples.java.gpu.SortBenchmark</program-class>
								</manifestEntries>
							</archive>
							<includes>
								<include>org/apache/flink/table/examples/java/gpu/SortBenchmark*</include>
							</includes>
						</configuration>
					</execution>
					<execution>
						<id>LogisticRegressionBenchmark</id>
						<phase>package</phase>
						<goals>
							<goal>jar</goal>
						</goals>
						<configuration>
							<classifier>LogisticRegressionBenchmark</classifier>
							<archive>
								<manifestEntries>
									<program-class>org.apache.flink.table.examples.java.gpu.LogisticRegressionBenchmark</program-class>
								</manifestEntries>
							</archive>
							<includes>
								<include>org/apache/flink/table/examples/java/gpu/LogisticRegressionBenchmark*</include>
							</includes>
						</configuration>
					</execution>
					<execution>
						<id>MixedTypeVerification</id>
						<phase>package</phase>
						<goals>
							<goal>jar</goal>
						</goals>
						<configuration>
							<classifier>MixedTypeVerification</classifier>
							<archive>
								<manifestEntries>
									<program-class>org.apache.flink.table.examples.java.gpu.MixedTypeVerification</program-class>
								</manifestEntries>
							</archive>
							<includes>
								<include>org/apache/flink/table/examples/java/gpu/MixedTypeVerification*</include>
							</includes>
						</configuration>
					</execution>
					<execution>
						<id>ReferenceJoinBenchmark</id>
						<phase>package</phase>
						<goals>
							<goal>jar</goal>
						</goals>
						<configuration>
							<classifier>ReferenceJoinBenchmark</classifier>
							<archive>
								<manifestEntries>
									<program-class>org.apache.flink.table.examples.java.gpu.ReferenceJoinBenchmark</program-class>
								</manifestEntries>
							</archive>
							<includes>
								<include>org/apache/flink/table/examples/java/gpu/ReferenceJoinBenchmark*</include>
							</includes>
						</configuration>
					</execution>
					<execution>
						<id>FeatureGramBenchmark</id>
						<phase>package</phase>
						<goals>
							<goal>jar</goal>
						</goals>
						<configuration>
							<classifier>FeatureGramBenchmark</classifier>
							<archive>
								<manifestEntries>
									<program-class>org.apache.flink.table.examples.java.gpu.FeatureGramBenchmark</program-class>
								</manifestEntries>
							</archive>
							<includes>
								<include>org/apache/flink/table/examples/java/gpu/FeatureGramBenchmark*</include>
							</includes>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-antrun-plugin</artifactId>
				<version>3.1.0</version>
				<executions>
					<execution>
						<id>rename</id>
						<phase>package</phase>
						<goals>
							<goal>run</goal>
						</goals>
						<configuration>
							<target>
								<copy file="${project.build.directory}/${project.artifactId}-${project.version}-GpuOffloadExample.jar" tofile="${project.build.directory}/GpuOffloadExample.jar"/>
								<copy file="${project.build.directory}/${project.artifactId}-${project.version}-HaversineBenchmark.jar" tofile="${project.build.directory}/HaversineBenchmark.jar"/>
								<copy file="${project.build.directory}/${project.artifactId}-${project.version}-GroupedAggregateBenchmark.jar" tofile="${project.build.directory}/GroupedAggregateBenchmark.jar"/>
								<copy file="${project.build.directory}/${project.artifactId}-${project.version}-SortBenchmark.jar" tofile="${project.build.directory}/SortBenchmark.jar"/>
								<copy file="${project.build.directory}/${project.artifactId}-${project.version}-LogisticRegressionBenchmark.jar" tofile="${project.build.directory}/LogisticRegressionBenchmark.jar"/>
								<copy file="${project.build.directory}/${project.artifactId}-${project.version}-MixedTypeVerification.jar" tofile="${project.build.directory}/MixedTypeVerification.jar"/>
								<copy file="${project.build.directory}/${project.artifactId}-${project.version}-ReferenceJoinBenchmark.jar" tofile="${project.build.directory}/ReferenceJoinBenchmark.jar"/>
								<copy file="${project.build.directory}/${project.artifactId}-${project.version}-FeatureGramBenchmark.jar" tofile="${project.build.directory}/FeatureGramBenchmark.jar"/>
							</target>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
