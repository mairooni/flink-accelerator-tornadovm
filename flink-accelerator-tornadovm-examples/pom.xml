		<dependency>
			<groupId>org.apache.flink</groupId>
			<artifactId>flink-connector-datagen</artifactId>
			<version>${flink.version}</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>io.github.beehive-lab</groupId>
			<artifactId>tornado-api</artifactId>
			<version>${tornado.version}</version>
			<scope>provided</scope>
		</dependency>
			<dependency>
			<groupId>io.github.beehive-lab</groupId>
			<artifactId>tornado-cudf</artifactId>
			<version>${tornado.version}</version>
			<scope>provided</scope>
		</dependency>
		<!--
			jitllm is compiled against but never packaged. It is deployed into the distribution's
			lib/, the same way the provider jar is, which is not a packaging convenience but a
			requirement: a model kept resident across jobs has to be held by a class the parent
			classloader owns, and anything inside a job jar is discarded with that job's
			classloader. See ResidentEngines.
		-->
		<dependency>
			<groupId>io.github.beehive-lab</groupId>
			<artifactId>jitllm</artifactId>
			<version>${jitllm.version}</version>
			<scope>provided</scope>
		</dependency>
	</dependencies>

